# Port API
PORT=3100

# Alamat bind. 0.0.0.0 agar dapat diakses perangkat lain di jaringan.
HOST=0.0.0.0

# Folder lokasi latest_scada_data.json dan multi_plant_data_*.json
# Kosongkan jika file JSON berada satu folder dengan app.js.
DATA_DIR=/home/tpsoticsraspia1/on/d-surya/d-program

# Gunakan * untuk semua origin, atau pisahkan beberapa origin dengan koma.
ALLOWED_ORIGIN=*

# Batas maksimum data histori dalam satu request.
MAX_HISTORY_LIMIT=5000